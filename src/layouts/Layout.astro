---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description } = Astro.props;
const siteDescription = description ?? 'Failure Modes in Agentic AI: From Reproducible Triggers and Diagnostics to Reliable Fixes. An EMNLP 2026 tutorial on how foundation-model agents fail and how to fix them.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={siteDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f9fafd" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..700&family=Literata:ital,opsz,wght@0,7..72,300..700;1,7..72,300..700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Design tokens. Neutrals are tinted toward the brand indigo (OKLCH hue 277);
     every text color clears WCAG AA (at least 5:1) on both paper tones. */
  :root {
    --header-height: 60px;
    --page-max-width: 1120px;
    --gutter: clamp(1rem, 0.5rem + 2.5vw, 2.5rem);

    --paper: oklch(0.985 0.004 277);
    --paper-deep: oklch(0.962 0.007 277);
    --rule: oklch(0.885 0.012 277);
    --ink: oklch(0.24 0.035 277);
    --ink-soft: oklch(0.40 0.025 277);
    --ink-faint: oklch(0.50 0.02 277);
    --brand: oklch(0.337 0.105 276);
    --brand-hover: oklch(0.45 0.13 277);
    --rubric: oklch(0.53 0.17 32);
    --ochre: oklch(0.52 0.10 75);
    --green: oklch(0.49 0.09 155);
    --on-ink: oklch(0.86 0.02 277);

    /* Archivo (semi-condensed) for titles and labels, Literata for reading text. */
    --font-display: 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-heading: var(--font-display);
    --font-serif: 'Literata', Georgia, 'Times New Roman', serif;
    --font-sans: 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --weight-display: 700;
    --weight-heading: 650;
    --stretch-heading: 87.5%;

    --text-label: 0.8125rem;
    --text-meta: 0.9375rem;
    --text-body: 1.0625rem;
    --text-lead: 1.125rem;
    --text-h3: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    --text-h2: clamp(2.125rem, 1.6rem + 2vw, 3rem);
    --text-display: clamp(2.75rem, 1.5rem + 5vw, 5.25rem);

    --space-2xs: 0.25rem;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;
    --space-3xl: 4rem;
    --space-4xl: 6rem;

    --ease-out: cubic-bezier(0.25, 1, 0.5, 1);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html {
    font-family: var(--font-serif);
    font-size: 100%;
    color: var(--ink);
    background: var(--paper);
    scroll-behavior: smooth;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
  body {
    min-height: 100vh;
    overflow-x: hidden;
    font-size: var(--text-body);
    line-height: 1.6;
    background: var(--paper);
  }
  main { padding-top: var(--header-height); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
