---
// Presenter cards. The four presenters are drawn from the EMNLP 2026
// tutorial submission author block; photos are the proposal headshots.
// Emails live in Contact.astro.
// Optional zoom and shift reproduce the proposal's \headshot[zoom][offset]
// framing: zoom enlarges the face inside the circle, and a positive shift
// (percent of the circle) moves the image down to centre a high-sitting face.

const speakers = [
  {
    name: 'Zoey Sha Li',
    role: 'Amazon',
    photo: '/speakers/zoey-sha-li.jpg',
    site: 'https://zoeyli.com',
  },
  {
    name: 'Zihan Wang',
    role: 'Northwestern University',
    photo: '/speakers/zihan-wang.jpg',
    zoom: 1.2,
    site: 'https://zihanwang314.github.io/',
  },
  {
    name: 'Hejie Cui',
    role: 'Google',
    photo: '/speakers/hejie-cui.jpg',
    zoom: 1.5,
    shift: 20,
    site: 'https://hejiecui.com',
  },
  {
    name: 'Manling Li',
    role: 'Northwestern University',
    photo: '/speakers/manling-li.jpg',
    site: 'https://limanling.github.io/',
  },
];
---
<section id="speakers" class="section">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title">Presenters</h2>
    </header>

    <ul class="people">
      {speakers.map((s) => (
        <li class="person">
          <div class="photo-wrap">
            {s.photo
              ? <img class="photo" src={s.photo} alt={`Portrait of ${s.name}`} loading="lazy" style={s.zoom && `transform: translateY(${s.shift ?? 0}%) scale(${s.zoom})`} />
              : <div class="photo placeholder" aria-hidden="true">{s.name.split(' ').map((p) => p[0]).join('').slice(0, 2)}</div>}
          </div>
          <h3 class="name">
            {s.site ? <a href={s.site} target="_blank" rel="noopener">{s.name}</a> : s.name}
          </h3>
          <p class="role">{s.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .people {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-2xl) var(--space-xl);
  }

  .photo-wrap {
    width: 112px;
    height: 112px;
    margin-bottom: var(--space-md);
    border-radius: 50%;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--stretch-heading);
    font-size: 1.75rem;
  }

  .name {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-stretch: var(--stretch-heading);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--ink);
  }

  .name a { text-decoration: none; }

  .name a:hover {
    color: var(--brand-hover);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .role {
    margin-top: var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--ink-soft);
  }
</style>
