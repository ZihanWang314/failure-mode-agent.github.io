---
// Presenter cards. The four presenters are drawn from the EMNLP 2026
// tutorial submission author block; photos are the proposal headshots.
// Emails live in Contact.astro.
// Optional zoom and shift reproduce the proposal's \headshot[zoom][offset]
// framing: zoom enlarges the face inside the circle, and a positive shift
// (percent of the circle) moves the image down to centre a high-sitting face.

const speakers = [
  {
    name: 'Zoey Sha Li',
    role: 'Amazon',
    photo: '/speakers/zoey-sha-li.jpg',
    site: 'https://zoeyli.com',
  },
  {
    name: 'Zihan Wang',
    role: 'Northwestern University',
    photo: '/speakers/zihan-wang.jpg',
    zoom: 1.2,
    site: 'https://zihanwang314.github.io/',
  },
  {
    name: 'Hejie Cui',
    role: 'Google',
    photo: '/speakers/hejie-cui.jpg',
    zoom: 1.5,
    shift: 20,
    site: 'https://hejiecui.com',
  },
  {
    name: 'Manling Li',
    role: 'Northwestern University',
    photo: '/speakers/manling-li.jpg',
    site: 'https://limanling.github.io/',
  },
];
---
<section id="speakers" class="content-section">
  <div class="section-container">
    <h2 class="section-title">Presenters</h2>

    <div class="speakers-grid">
      {speakers.map((s) => (
        <article class="speaker-card">
          <div class="photo-wrap">
            {s.photo
              ? <img class="photo" src={s.photo} alt={s.name} style={s.zoom && `transform: translateY(${s.shift ?? 0}%) scale(${s.zoom})`} />
              : <div class="photo placeholder" aria-hidden="true">{s.name.split(' ').map((p) => p[0]).join('').slice(0, 2)}</div>}
          </div>
          <div class="sp-info">
            <h3 class="sp-name">
              {s.site ? <a href={s.site} target="_blank" rel="noopener">{s.name}</a> : s.name}
            </h3>
            <p class="sp-role">{s.role}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  #speakers { background: white; padding: 4rem 1rem; }

  .section-container { max-width: var(--page-max-width, 1100px); margin: 0 auto; }

  .section-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: #2a2f6c;
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .speakers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
  }

  .speaker-card {
    background: white;
    border: 1px solid #e8eaf2;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .speaker-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(42, 47, 108, 0.08);
    border-color: rgba(42, 47, 108, 0.2);
  }

  .photo-wrap {
    width: 150px;
    height: 150px;
    margin: 1.6rem auto 0.3rem;
    border-radius: 50%;
    overflow: hidden;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #2a2f6c, #4a56c9);
    color: white;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .sp-info {
    text-align: center;
    padding: 0.95rem 0.9rem 1.2rem;
  }

  .sp-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #2a2f6c;
    margin-bottom: 0.3rem;
  }
  .sp-name a { color: #2a2f6c; text-decoration: none; }
  .sp-name a:hover { color: #4a56c9; text-decoration: underline; }

  .sp-role {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.45;
  }

  @media (max-width: 600px) {
    .section-title { font-size: 1.9rem; }
  }
</style>
