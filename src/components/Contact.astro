---
// Contact: presenter emails.
const contacts = [
  { name: 'Zoey Sha Li', email: 'mail@zoeyli.com' },
  { name: 'Zihan Wang', email: 'zihanw@u.northwestern.edu' },
  { name: 'Hejie Cui', email: 'hcui24@cs.stanford.edu' },
  { name: 'Manling Li', email: 'manling.li@northwestern.edu' },
];
---
<section id="contact" class="section">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title">Contact</h2>
    </header>

    <ul class="contacts">
      {contacts.filter((c) => c.email).map((c) => (
        <li class="contact">
          <span class="c-name">{c.name}</span>
          <a href={`mailto:${c.email}`} class="c-email">{c.email}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* A ruled two-column list: name on the left, address on the right. */
  .contacts {
    list-style: none;
    max-width: 42rem;
    border-top: 1px solid var(--ink);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-lg);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--rule);
  }

  .c-name {
    font-size: var(--text-body);
    color: var(--ink);
  }

  .c-email {
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--brand);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .c-email:hover {
    color: var(--brand-hover);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
