---
// Contact: presenter emails.
const contacts = [
  { name: 'Zoey Sha Li', email: '' },
  { name: 'Zihan Wang', email: 'zihanw@u.northwestern.edu' },
  { name: 'Hejie Cui', email: 'hejie.cui@stanford.edu' },
  { name: 'Manling Li', email: 'manling.li@northwestern.edu' },
];
---
<section id="contact" class="content-section">
  <div class="section-container">
    <h2 class="section-title">Contact</h2>
    <ul class="contact-list">
      {contacts.filter((c) => c.email).map((c) => (
        <li class="contact-item">
          <span class="c-name">{c.name}</span>
          <a href={`mailto:${c.email}`} class="email-pill">{c.email}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  #contact { background: #f8f9fa; padding: 4rem 1rem; }

  .section-container { max-width: var(--page-max-width, 1100px); margin: 0 auto; }

  .section-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: #2a2f6c;
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: white;
    border: 1px solid #e6e8ef;
    border-radius: 12px;
    padding: 0.9rem 1.2rem;
  }

  .c-name {
    color: #2a2f6c;
    font-weight: 700;
    font-size: 1rem;
  }

  .email-pill {
    background: #f0f1f8;
    color: #2a2f6c;
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }

  .email-pill:hover { background: #e3e5f5; }

  @media (max-width: 600px) {
    .section-title { font-size: 1.9rem; }
    .contact-item { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
</style>
