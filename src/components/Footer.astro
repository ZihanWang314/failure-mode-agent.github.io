---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <p class="line-1">
      <strong>FAGEN</strong> Tutorial &middot; EMNLP 2026
    </p>
    <p class="line-2">
      &copy; {year} the FAGEN Tutorial organizers. Site source uses the
      <a href="https://github.com/RAGEN-AI/ragen-ai.github.io" target="_blank" rel="noopener">RAGEN v1</a> template.
      Materials released under CC BY-NC 4.0 unless otherwise noted.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #1f2358;
    color: #d8daeb;
    padding: 2rem 1rem;
    margin-top: 0;
    text-align: center;
    font-size: 0.88rem;
  }

  .footer-inner {
    max-width: var(--page-max-width, 1100px);
    margin: 0 auto;
  }

  .line-1 {
    color: white;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .line-2 {
    color: #b8bce0;
    line-height: 1.65;
  }

  .site-footer a {
    color: #aab0e8;
    text-decoration: none;
    border-bottom: 1px dotted #aab0e8;
  }

  .site-footer a:hover {
    color: white;
    border-bottom-color: white;
  }
</style>
