---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="line-1">
      <strong>Failure Modes in Agentic AI</strong> &middot; EMNLP 2026 Tutorial
    </p>
    <p class="line-2">
      &copy; {year} the tutorial organizers. Site source uses the
      <a href="https://github.com/RAGEN-AI/ragen-ai.github.io" target="_blank" rel="noopener">RAGEN v1</a> template.
      Materials released under CC BY-NC 4.0 unless otherwise noted.
    </p>
  </div>
</footer>

<style>
  /* Colophon: light text on ink, with extra leading for legibility. */
  .site-footer {
    padding-block: var(--space-2xl);
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .footer-inner {
    display: grid;
    gap: var(--space-xs);
  }

  .line-1 {
    font-family: var(--font-serif);
    font-size: var(--text-body);
    color: var(--paper);
  }

  .line-1 strong { font-weight: 400; font-style: italic; }

  .line-2 { max-width: 70ch; }

  .site-footer a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
