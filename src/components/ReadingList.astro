---
<section id="reading" class="section">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title">Reading List</h2>
      <p class="section-dek"><span class="star-inline" aria-hidden="true">&#9733;</span> marks recommended pre-tutorial reading.</p>
    </header>

    <div class="blocks">
      {sections.map((s) => (
        <div class="block split">
          <div class="block-head">
            <span class="label block-part">{s.part}</span>
            <h3 class="block-title">{s.title}</h3>
          </div>
          <ul class="refs">
            {s.items.map((it) => (
              <li class="ref">
                {it.recommended && <span class="star" role="img" aria-label="Recommended" title="Recommended pre-tutorial reading">&#9733;</span>}
                <a class="ref-title" href={it.link} target="_blank" rel="noopener">
                  {it.label && <span class="ref-label">{it.label}</span>}
                  {it.title}
                </a>
                <span class="ref-meta">{it.authors} <span aria-hidden="true">&middot;</span> {it.venue}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* A bibliography: each part opens with an ink rule and uses the shared meta
     column for its number and title; entries are separated by space, not boxes. */
  .block {
    padding-block: var(--space-xl) var(--space-2xl);
    border-top: 1px solid var(--ink);
  }

  .block:last-child { padding-bottom: 0; }

  .block-part {
    display: block;
    margin-bottom: var(--space-2xs);
    color: var(--rubric);
  }

  .block-title {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-stretch: var(--stretch-heading);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--ink);
    text-wrap: balance;
  }

  .refs {
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  /* Titles align whether or not an entry carries the recommended star. */
  .ref {
    position: relative;
    display: grid;
    gap: var(--space-2xs);
    padding-left: 1.4rem;
  }

  .star,
  .star-inline { color: var(--rubric); }

  .star {
    position: absolute;
    left: 0;
    top: 0.15rem;
    font-size: 0.95rem;
  }

  .ref-title {
    font-size: var(--text-body);
    line-height: 1.45;
    color: var(--brand);
    text-decoration: none;
    text-wrap: pretty;
  }

  .ref-title:hover {
    color: var(--brand-hover);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .ref-label {
    margin-right: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .ref-meta {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-faint);
  }
</style>
