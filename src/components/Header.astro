---
// Sticky top navigation for the tutorial site.
---
<header>
  <div class="container">
    <a href="#hero" class="info-badge" aria-label="Failure Modes in Agentic AI">
      <span class="badge-mark" aria-hidden="true">FA</span>
      <span class="badge-text">Failure Modes in Agentic AI</span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      <ul>
        <li><a href="#abstract">Abstract</a></li>
        <li><a href="#schedule">Schedule</a></li>
        <li><a href="#outline">Outline</a></li>
        <li><a href="#reading">Reading List</a></li>
        <li><a href="#speakers">Presenters</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    background-color: #ffffffd9;
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid #e7e7ee;
    height: var(--header-height, 60px);
    display: flex;
    align-items: center;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }

  .container {
    max-width: var(--page-max-width, 1100px);
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 1rem;
  }

  .info-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #212529;
    padding: 4px 4px 4px 4px;
    border-radius: 999px;
    transition: opacity 0.2s ease;
    min-width: 0;
    overflow: hidden;
  }

  .info-badge:hover { opacity: 0.85; }

  .badge-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #2a2f6c;
    color: white;
    font-weight: 800;
    font-size: 0.8rem;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .badge-text {
    font-weight: 600;
    font-size: 0.95rem;
    color: #2a2f6c;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: nowrap;
  }

  .main-nav a {
    text-decoration: none;
    color: #555;
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.5rem 0.7rem;
    border-radius: 6px;
    transition: color 0.2s ease, background-color 0.2s ease;
    white-space: nowrap;
  }

  .main-nav a:hover,
  .main-nav a:focus { color: #2a2f6c; background-color: rgba(42, 47, 108, 0.06); }

  @media (max-width: 900px) {
    .main-nav a { font-size: 0.85rem; padding: 0.4rem 0.5rem; }
    .badge-text { display: none; }
  }

  @media (max-width: 640px) {
    .main-nav ul { gap: 0; overflow-x: auto; }
    .main-nav a { font-size: 0.8rem; padding: 0.4rem 0.4rem; }
  }
</style>
