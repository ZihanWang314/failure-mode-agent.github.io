---
// Time-budgeted schedule for a 3-hour tutorial slot (3.5 h with break).
const rows = [
  { time: '0:00 - 0:35', session: 'Part 1: Agent Environments and Infrastructure', detail: 'Agent loop anatomy, canonical scaffolds, a taxonomy of failure surfaces, and what a reproducible trigger looks like.', who: 'Manling Li' },
  { time: '0:35 - 1:25', session: 'Part 2: Training Dynamics', detail: 'Reward design and hacking, optimization-induced collapse, and stabilization recipes. Safety: reward hacking under constraints.', who: 'Zoey Sha Li' },
  { time: '1:25 - 1:55', session: 'Coffee break', detail: '', who: '', isBreak: true },
  { time: '1:55 - 2:40', session: 'Part 3: Evaluation and Trace Diagnostics', detail: 'Why static benchmarks miss failures, closed-loop and asynchronous evaluation, and trace-level diagnostics. Safety: attack-surface evaluation.', who: 'Zihan Wang' },
  { time: '2:40 - 3:15', session: 'Part 4: Test-Time Scaling and Adaptation', detail: 'When more inference hurts, budget-aware agents, exploration control, and context management. Safety: guardrails under long interaction.', who: 'Hejie Cui' },
  { time: '3:15 - 3:30', session: 'Synthesis and Q&A', detail: 'Discussion across the four axes; release of reproductions and trace examples.', who: 'All presenters' },
];
---
<section id="schedule" class="content-section">
  <div class="section-container">
    <h2 class="section-title">Schedule</h2>

    <div class="schedule-table-wrap">
      <table class="schedule-table">
        <thead>
          <tr>
            <th class="col-time">Time</th>
            <th class="col-sess">Session</th>
            <th class="col-who">Presenter</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class={r.isBreak ? 'is-break' : ''}>
              <td class="col-time mono">{r.time}</td>
              <td class="col-sess">
                <div class="sess-name">{r.session}</div>
                {r.detail && <div class="sess-detail">{r.detail}</div>}
              </td>
              <td class="col-who">{r.who}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  #schedule { background: white; padding: 4rem 1rem; }

  .section-container { max-width: var(--page-max-width, 1100px); margin: 0 auto; }

  .section-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: #2a2f6c;
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .schedule-table-wrap {
    border: 1px solid #e6e8ef;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(42, 47, 108, 0.04);
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .schedule-table thead th {
    background: #2a2f6c;
    color: white;
    text-align: left;
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.85rem 1rem;
  }

  .schedule-table tbody tr {
    border-bottom: 1px solid #f0f1f5;
    background: white;
    transition: background-color 0.15s ease;
  }

  .schedule-table tbody tr:last-child { border-bottom: none; }
  .schedule-table tbody tr:hover { background: #fafbff; }

  .schedule-table tbody tr.is-break {
    background: #f5f6fa;
    color: #888;
    font-style: italic;
  }

  .schedule-table td {
    padding: 0.95rem 1rem;
    vertical-align: top;
    line-height: 1.55;
  }

  .col-time { width: 11rem; }
  .col-who  { width: 14rem; color: #555; font-weight: 500; }

  .mono {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    color: #2a2f6c;
    font-weight: 600;
  }

  .sess-name { color: #2a2f6c; font-weight: 600; margin-bottom: 0.15rem; }
  .sess-detail { color: #666; font-size: 0.88rem; }

  @media (max-width: 800px) {
    .schedule-table { font-size: 0.88rem; }
    .col-time { width: 6.5rem; }
    .col-who { display: none; }
    .schedule-table td { padding: 0.7rem 0.7rem; }
  }
</style>
