---
// Hero / masthead. Venue line, title, subtitle, byline, and quick links.

// Set to the slides URL once they are posted; the Slides button then becomes
// an active primary link instead of a disabled "Coming soon" placeholder.
const slidesUrl = '';
const SlidesTag = slidesUrl ? 'a' : 'span';

const presenters = ['Zoey Sha Li', 'Zihan Wang', 'Hejie Cui', 'Cheng Qian', 'Manling Li'];
const byline = `${presenters.slice(0, -1).join(', ')}, and ${presenters.at(-1)}`;
---
<section id="hero" class="hero">
  <div class="wrap">
    <p class="label hero-kicker reveal">EMNLP 2026 Tutorial <span aria-hidden="true">&middot;</span> November 2026</p>
    <h1 class="hero-title reveal">Failure Modes in Agentic AI</h1>
    <p class="hero-subtitle reveal">From Reproducible Triggers and Diagnostics to Reliable Fixes</p>
    <p class="hero-byline reveal"><a href="#speakers">{byline}</a></p>

    <div class="hero-links reveal">
      <a href="#schedule" class="hero-link">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hero-icon" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>Schedule</span>
      </a>
      <SlidesTag
        href={slidesUrl || undefined}
        target={slidesUrl ? '_blank' : undefined}
        rel={slidesUrl ? 'noopener' : undefined}
        class:list={['hero-link', slidesUrl ? 'primary' : 'is-disabled']}
        aria-disabled={slidesUrl ? undefined : 'true'}
        title={slidesUrl ? undefined : 'Slides will be posted closer to the tutorial'}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hero-icon" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
          <line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
        </svg>
        <span>Slides</span>
        {!slidesUrl && <span class="soon">coming soon</span>}
      </SlidesTag>
      <a href="#speakers" class="hero-link">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hero-icon" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>Presenters</span>
      </a>
      <a href="mailto:mail@zoeyli.com,zihanw@u.northwestern.edu,hcui24@cs.stanford.edu,chengq9@illinois.edu,manling.li@northwestern.edu" class="hero-link">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hero-icon" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        <span>Contact</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Masthead: left-aligned, closed by a double rule like a journal title page. */
  .hero {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7.5rem) clamp(3rem, 2rem + 4vw, 5rem);
    border-bottom: 4px double var(--ink-soft);
  }

  .hero-kicker {
    color: var(--rubric);
    margin-bottom: var(--space-lg);
  }

  .hero-title {
    max-width: 13ch;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--stretch-heading);
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero-subtitle {
    max-width: 34ch;
    margin-top: var(--space-lg);
    font-style: italic;
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    line-height: 1.35;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  .hero-byline {
    margin-top: var(--space-xl);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 500;
    color: var(--ink);
  }

  .hero-byline a { text-decoration: none; }

  .hero-byline a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--ink);
    border-radius: 2px;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .hero-link:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .hero-link.primary {
    background: var(--ink);
    color: var(--paper);
  }

  .hero-link.primary:hover {
    background: var(--brand-hover);
    border-color: var(--brand-hover);
  }

  .hero-link.is-disabled {
    border-style: dashed;
    border-color: var(--ink-faint);
    color: var(--ink-faint);
    cursor: not-allowed;
  }

  .hero-link.is-disabled:hover {
    background: transparent;
    color: var(--ink-faint);
  }

  .soon {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.875rem;
  }

  .hero-icon {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 1.75;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* One orchestrated entrance: the masthead settles in, line by line. */
  .reveal { animation: rise 0.7s var(--ease-out) both; }
  .reveal:nth-child(2) { animation-delay: 0.08s; }
  .reveal:nth-child(3) { animation-delay: 0.16s; }
  .reveal:nth-child(4) { animation-delay: 0.24s; }
  .reveal:nth-child(5) { animation-delay: 0.32s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { animation: none; }
  }
</style>
